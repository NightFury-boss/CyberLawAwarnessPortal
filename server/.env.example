# ==============================================================================
# Cyber Law Awareness Portal — Server Environment Configuration
# ==============================================================================

# Server Environment & Port
PORT=5000
NODE_ENV=development

# Frontend Origin & CORS Policy
# In development: Defaults to http://localhost:5173
# In production: MUST be an explicit HTTPS domain (e.g., https://cyberlawportal.gov.in).
# Multiple origins may be provided as comma-separated values.
# IMPORTANT: In production (NODE_ENV=production), localhost and loopback IPs are strictly rejected.
CLIENT_URL=http://localhost:5173

# Authentication Secret (JWT)
# In production: MUST be at least 32 characters with high cryptographic entropy.
# Server startup will FAIL-CLOSED if missing, empty, or set to a known sample placeholder.
# Generate a secure production secret with:
#   openssl rand -hex 32
#   OR: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_secret_key_in_production_environments

# Database Connection
# In development: Local MongoDB URI or Atlas dev cluster
# In production: Secured MongoDB Atlas cluster URI with TLS/SSL enabled
MONGODB_URI=mongodb://localhost:27017/cyber_law_portal

# Initial Administrator Credentials (used during database seeding)
ADMIN_EMAIL=admin@cyberlawportal.test
ADMIN_PASSWORD=change_this_password_in_development

# Spaced Retrieval & Educational Schedule
SPACED_RETRIEVAL_DELAY_DAYS=7

# Reverse Proxy Configuration
# Set to '1' or true when running behind a reverse proxy / load balancer
# (e.g., Nginx, Cloudflare, AWS ALB) for accurate client IP resolution and HTTPS detection.
TRUST_PROXY=1

# Rate Limiting Configuration (In-Memory Sliding Window)
# Note: Designed for single-instance deployments. For horizontal multi-instance scaling,
# deploy a distributed Redis store.
#
# Authentication endpoints (/api/auth/register, /api/auth/login)
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_MS=900000

# AI Legal Awareness Assistant (/api/assistant/ask)
RATE_LIMIT_ASSISTANT_MAX=30
RATE_LIMIT_ASSISTANT_WINDOW_MS=60000
