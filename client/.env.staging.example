# ==============================================================================
# Cyber Law Awareness Portal — Netlify Frontend Staging Environment Template
# Configure this in Netlify Site Settings > Environment Variables
# ==============================================================================

# URL of the deployed Render Web Service backend (must end in /api or will be auto-normalized)
# Example: https://cyberlaw-portal-backend.onrender.com/api
VITE_API_URL=https://<your-render-backend-name>.onrender.com/api

# Environment classification ('staging' or 'production')
VITE_APP_ENV=staging

# Cold-start & API timeout settings (optional overrides; defaults are 60s cold start, 15s standard, 4s notice delay)
VITE_API_COLD_START_TIMEOUT_MS=60000
VITE_API_TIMEOUT_MS=15000
VITE_COLD_START_NOTICE_DELAY_MS=4000
