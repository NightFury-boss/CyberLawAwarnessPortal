# ==============================================================================
# Cyber Law Awareness Portal — Staging Environment Template (Root)
# Copy this file to .env.staging and populate with staging credentials before running:
# docker compose --env-file .env.staging -f docker-compose.staging.yml up -d --build
# ==============================================================================

# Server Environment & Port
PORT=5000
NODE_ENV=production

# Trusted Frontend Origin (CORS Policy)
# In staging: MUST be the exact HTTPS URL of your staging deployment (no trailing slash)
# Example: https://staging.cyberlawportal.org
CLIENT_URL=https://staging.cyberlawportal.org

# Staging Host Ingress Binding
# Bind to 127.0.0.1 so only the Host Reverse Proxy (Host Nginx/Certbot/Cloudflare) can access Docker.
# Prevents direct external bypass of your SSL/TLS termination layer.
STAGING_HOST_BIND=127.0.0.1
STAGING_PORT=8080

# JWT Authentication Secret
# Must be at least 32 characters with high cryptographic entropy.
# Generate on Linux/macOS with: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string_here_12345

# Database Connection
# Dedicated MongoDB Atlas Staging Cluster URI (with TLS/SSL enabled)
# Provide your actual staging Atlas connection string in your local .env.staging file (never commit live credentials)
MONGODB_URI=mongodb+srv://<staging_username>:<staging_password>@<staging_cluster>.mongodb.net/cyber_law_staging?retryWrites=true&w=majority

# Reverse Proxy Trust
# Set to '1' when running behind Docker Nginx, Cloudflare, or AWS ALB
TRUST_PROXY=1

# Initial Administrator Credentials (used during seed initialization)
ADMIN_EMAIL=staging-admin@cyberlawportal.org
ADMIN_PASSWORD=change_this_to_a_strong_staging_admin_password_123!

# Spaced Retrieval Interval (Days)
SPACED_RETRIEVAL_DELAY_DAYS=7

# Sliding Window Rate Limits
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_ASSISTANT_MAX=30
RATE_LIMIT_ASSISTANT_WINDOW_MS=60000

# Scoring v2 Operational Cutover Date (ISO 8601 UTC)
SCORING_V2_CUTOVER_DATE=2026-11-04T00:00:00.000Z

